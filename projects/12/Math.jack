class Math {
    static int n;             // number of usable bits (15: 0..14), avoiding 2^15 overflow
    static Array powersOfTwo; // powersOfTwo[i] = 2^i for i=0..14

    function void init() {
        var int i;
        var int p;

        let n = 15;                   
        let powersOfTwo = Array.new(n); // [0..14]

        let i = 0;
        let p = 1;
        while (i < n) {
            let powersOfTwo[i] = p;
            let p = p + p;            // 1,2,4,...,16384
            let i = i + 1;
        }
        return;
    }

    function int multiply(int x, int y) {
        var int a, b;
        var int i;
        var int res;
        var int term;
        var int neg;
        var int mask;

        let neg = 0;
        if (x < 0) { let neg = ~neg; }
        if (y < 0) { let neg = ~neg; }

        let a = Math.abs(x);
        let b = Math.abs(y);

        let res = 0;
        let term = a;

        let i = 0;
        while (i < n) {               // iterate over bits 0..14 only
            let mask = powersOfTwo[i];
            if (~((b & mask) = 0)) {
                let res = res + term;
            }
            let term = term + term;
            let i = i + 1;
        }

        if (~(neg = 0)) { return 0 - res; }
        return res;
    }

    function int divide(int x, int y) {
        var int a, b;
        var int neg;
        var int q;
        var int r;
        var int i, j;
        var int denom;

        if (y = 0) {
            do Sys.error(3);
            return 0;
        }

        let neg = 0;
        if (x < 0) { let neg = ~neg; }
        if (y < 0) { let neg = ~neg; }

        let a = Math.abs(x);
        let b = Math.abs(y);

        let q = 0;
        let r = a;

        // i = 14 down to 0 (n is 15)
        let i = n - 1;
        while (~(i < 0)) {

            // denom = b * 2^i, but guard overflow
            let denom = b;
            let j = 0;
            while (j < i) {
                let denom = denom + denom;

                // Overflow guard: denom is repeatedly doubled. If it becomes negative,
                // the sign bit (bit 15) flipped, meaning 16-bit overflow occurred.
                // In that case, force denom > r so this bit is not selected.
                if (denom < 0) {
                    let denom = r + 1;   // force denom > r so we skip this bit
                    let j = i;  
                }       

                let j = j + 1;
            }

            // if denom <= r
            if (~(denom > r)) {
                let r = r - denom;
                let q = q + powersOfTwo[i];
            }

            let i = i - 1;
        }

        if (~(neg = 0)) {
            return 0 - q;
        }
        return q;
    }

    function int sqrt(int x) {
        var int num;
        var int res;
        var int bit;
        var int tmp;

        if (x < 0) {
            do Sys.error(4);
            return 0;
        }

        let num = x;
        let res = 0;
        let bit = powersOfTwo[14];     // 16384 (OK)

        while (bit > num) {
            let bit = Math.divide(bit, 4);
        }

        while (~(bit = 0)) {
            let tmp = res + bit;

            if (~(num < tmp)) {
                let num = num - tmp;
                let res = Math.divide(res, 2) + bit;
            } else {
                let res = Math.divide(res, 2);
            }

            let bit = Math.divide(bit, 4);
        }

        return res;
    }

    function int max(int a, int b) {
        if (a > b) { return a; }
        return b;
    }

    function int min(int a, int b) {
        if (a < b) { return a; }
        return b;
    }

    function int abs(int x) {
        if (x < 0) { return 0 - x; }
        return x;
    }
}