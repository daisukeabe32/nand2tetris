class Sys {

    function void init() {
        do Memory.init();
        do Math.init();
        do Screen.init();
        do Output.init();
        do Keyboard.init();

        do Main.main();
        do Sys.halt();
        return;
    }

    function void halt() {
        while (true) { }
        return;
    }

    function void wait(int duration) {
        var int i, j;
        var int sink;

        let sink = 0;
        let i = 0;

        while (i < duration) {
            let j = 0;

            // ★ここを調整して「1msっぽさ」を合わせる
            while (j < 250) {
                let sink = sink + j;
                let j = j + 1;
            }

            let i = i + 1;
        }

        return;
    }

    function void error(int errorCode) {
        do Output.printString("ERR");
        do Output.printInt(errorCode);
        do Output.println();
        do Sys.halt();
        return;
    }
}