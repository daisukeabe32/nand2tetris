// File name: projects/12/Keyboard.jack
/**
 * A library for handling user input from the keyboard.
 */
class Keyboard {

    /** Initializes the keyboard. */
    function void init() {
        return;
    } 

    /**
     * Returns the character of the currently pressed key on the keyboard;
     * if no key is currently pressed, returns 0.
     */
    function char keyPressed() {
        return Memory.peek(24576);   // KBD
    }

    /** Waits until a key is pressed and released, echoes it, and returns it. */
    function char readChar() {
        var char c;

        // wait for press
        while (Keyboard.keyPressed() = 0) { }

        let c = Keyboard.keyPressed();

        // wait for release (debounce)
        while (~(Keyboard.keyPressed() = 0)) { }

        // echo (printable only; but spec says echo the key, so printChar)
        do Output.printChar(c);
        return c;
    }

    /** Reads a line (until newline), echoing, handling backspaces. */
    function String readLine(String message) {
        var String s;
        var char c;

        do Output.printString(message);

        // allow up to 80 chars (good enough for tests)
        let s = String.new(80);

        while (true) {
            // wait press
            while (Keyboard.keyPressed() = 0) { }
            let c = Keyboard.keyPressed();
            // wait release
            while (~(Keyboard.keyPressed() = 0)) { }

            // newline ends line
            if (c = String.newLine()) {
                do Output.println();
                return s;
            }

            // backspace edits line
            if (c = String.backSpace()) {
                if (s.length() > 0) {
                    do s.eraseLastChar();
                    do Output.backSpace();
                }
            } else {
                // printable / normal char
                do s.appendChar(c);
                do Output.printChar(c);
            }
        }

        // unreachable
        return s;
    }   

    /** Reads an int (line then parse), echoing, handling backspaces. */
    function int readInt(String message) {
        var String s;
        let s = Keyboard.readLine(message);
        return s.intValue();
    }
}