class String {

    field Array data;
    field int length;
    field int maxLength;

    // Note: we allocate at least 1 cell to avoid Array.new(0) errors,
    // but keep maxLength as requested by the caller.
    constructor String new(int maxLen) {
        var int cap;

        // Array.new(0) is not allowed
        let cap = maxLen;
        if (cap < 1) {
            let cap = 1;
        }

        let data = Array.new(cap);
        let length = 0;
        let maxLength = maxLen;

        return this;
    }

    /** Disposes this string. */
    method void dispose() {
        do data.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Returns the current length of this string. */
    // No bounds checking (assumes 0 <= j < length).
    method int length() {
        return length;
    }

    /** Returns the character at the j-th location of this string. */
    // No bounds checking (assumes 0 <= j < length).
    method char charAt(int j) {
        return data[j];
    }

    /** Sets the character at the j-th location of this string to c. */
    method void setCharAt(int j, char c) {
        let data[j] = c;
        return;
    }

    /** Appends c to this string's end and returns this string. */
    method String appendChar(char c) {
        if (length < maxLength) {
            let data[length] = c;
            let length = length + 1;
        }
        return this;
    }

    /** Erases the last character from this string. */
    method void eraseLastChar() {
        if (length > 0) {
            let length = length - 1;
        }
        return;
    }

    /** Returns the integer value of this string,
     *  until a non-digit character is detected. */
     // Note: '*' and '/' are compiled into calls to Math.multiply / Math.divide.
    method int intValue() {
        var int i, value, digit, sign;

        let i = 0;
        let value = 0;
        let sign = 1;

        if (length = 0) {
            return 0;
        }

        // optional leading minus
        if (data[0] = 45) {      // '-'
            let sign = 0 - sign; // sign = -1
            let i = 1;
        }

        while (i < length) {
            let digit = data[i] - 48;   // '0' = 48
            if ((digit < 0) | (digit > 9)) {
                return value * sign;
            }
            let value = (value * 10) + digit;
            let i = i + 1;
        }

        return value * sign;
    }

    /** Sets this string to hold a representation of the given value. */
    // Note: '*' and '/' are compiled into calls to Math.multiply / Math.divide.
    method void setInt(int val) {
        var int temp, digit;
        var int start, i, j;
        var char c;

        let length = 0;

        if (val = 0) {
            do appendChar(48);   // '0'
            return;
        }

        let temp = val;

        // handle sign
        if (temp < 0) {
            do appendChar(45);   // '-'
            let temp = 0 - temp;
            let start = 1;       // digits start after '-'
        } else {
            let start = 0;
        }

        // append digits in reverse order
        while (temp > 0) {
            let digit = temp - ((temp / 10) * 10);
            do appendChar(digit + 48);
            let temp = temp / 10;
        }

        // reverse digits portion in-place: [start .. length-1]
        let i = start;
        let j = length - 1;

        while (i < j) {
            let c = data[i];
            let data[i] = data[j];
            let data[j] = c;
            let i = i + 1;
            let j = j - 1;
        }

        return;
    }

    function char newLine() {
        return 128;
    }

    function char backSpace() {
        return 129;
    }
    function char doubleQuote() { return 34; }
}